# GEMINI_API_KEY: Optional for AI-assisted editorial tasks (not exposed to browser).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public canonical URL of the portal (used for OG tags, Facebook Sharing, Sitemaps).
APP_URL="http://localhost:3000"

# JWT_SECRET: Strong secret key for signing admin & reporter authentication sessions.
JWT_SECRET="change-this-to-a-strong-64-char-random-secret"

# SUPABASE CONFIGURATION (For Netlify + Supabase PostgreSQL production deployment)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# NETLIFY BUILD HOOK (Optional: trigger rebuilds from Admin Deployment panel)
NETLIFY_BUILD_HOOK_URL=""

# GOOGLE ANALYTICS & SEARCH CONSOLE (Optional, can also be managed from Admin SEO Settings)
VITE_GA_MEASUREMENT_ID=""
